{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "easy-slide",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "build": {
    "command": "npm run build",
    "watch_dir": ["src", "public", "index.html", "vite.config.ts"],
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
}
