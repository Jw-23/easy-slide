{
  "name": "easy-slide",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests docs *.ts *.json *.md index.html",
    "deploy": "wrangler deploy",
    "cf:check": "wrangler deploy --dry-run",
    "cf:dev": "wrangler dev --ip 127.0.0.1 --port 8787",
    "test:pwa": "npm run build && playwright test --config playwright.pwa.config.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@vitejs/plugin-react": "^5.1.0",
    "codemirror": "^6.0.2",
    "idb-keyval": "^6.2.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "mathjax-full": "^3.2.2",
    "pptxgenjs": "^4.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.9.10",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "^4.0.0",
    "wrangler": "4.158.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
